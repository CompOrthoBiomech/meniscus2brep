{
  "breps": {
    "femur": "examples/femur.stl",
    "tibia": "examples/tibia.stl",
    "patella": "examples/patella.stl",
    "lateral_meniscus": "examples/lateral_meniscus_hex.brep",
    "medial_meniscus": "examples/medial_meniscus_hex.brep",
    "lateral_tibial_cartilage": "examples/lateral_tibial_cartilage_hex.brep",
    "medial_tibial_cartilage": "examples/medial_tibial_cartilage_hex.brep",
    "patellar_cartilage": "examples/patellar_cartilage_hex.brep",
    "femoral_cartilage": "examples/femoral_cartilage_hex.brep"
